<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorCardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_rounded_background">

        <!-- Top Row: Title, Percentage, Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_goal_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Emergency Fund"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorTextPrimary" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="65%"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/wealth_green"
                android:background="@drawable/badge_green"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/btn_delete_goal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/pb_goal_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:max="100"
            android:progress="65"
            android:progressTint="@color/wealth_green"
            android:progressBackgroundTint="?attr/colorBorderStrong" />

        <!-- Saved vs Target Numbers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_amounts_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹65,000 / ₹1,00,000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextSecondary" />

                <TextView
                    android:id="@+id/tv_goal_deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: 31 Dec, 2026"
                    android:textSize="12sp"
                    android:textColor="?attr/colorTextMuted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Contribute Button -->
            <Button
                android:id="@+id/btn_contribute"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Contribute"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
