<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorCardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="@drawable/card_rounded_background">

        <!-- Checkbox / Toggle complete -->
        <CheckBox
            android:id="@+id/cb_completed"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:buttonTint="@color/wealth_green" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_habit_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save ₹200 daily"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorTextPrimary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_frequency_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAccentBrand"
                    android:background="@drawable/badge_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_streak_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 5 Days"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/wealth_amber"
                    android:background="@drawable/badge_amber" />
            </LinearLayout>
        </LinearLayout>

        <!-- Target Amount & Delete -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_target_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: ₹200"
                android:textSize="12sp"
                android:textColor="?attr/colorTextMuted" />

            <ImageView
                android:id="@+id/btn_delete_habit"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                android:layout_marginTop="6dp"
                android:padding="3dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
