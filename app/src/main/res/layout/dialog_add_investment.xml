<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asset / Security Name *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_asset_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="e.g. Nifty 50 Index Fund, Apple Inc"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asset Type / Class *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/sp_asset_type"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount Invested (Cost Basis) *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_amount_invested"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="50000"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:inputType="numberDecimal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Market Value *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_current_value"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="58500"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:inputType="numberDecimal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Investment Date *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_investment_date"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:focusable="false"
        android:clickable="true"
        android:hint="YYYY-MM-DD"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />
</LinearLayout>
