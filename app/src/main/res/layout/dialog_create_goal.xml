<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Goal Title / Milestone *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_goal_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="e.g. Emergency Fund (6 Months)"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Amount *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_goal_target"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="150000"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:inputType="numberDecimal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initial Seed / Current Savings (Optional)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_goal_saved"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="0.00"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:inputType="numberDecimal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Deadline (Optional)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_goal_deadline"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:focusable="false"
        android:clickable="true"
        android:hint="YYYY-MM-DD"
        android:textColorHint="?attr/colorTextDim"
        android:textColor="?attr/colorTextPrimary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />
</LinearLayout>
