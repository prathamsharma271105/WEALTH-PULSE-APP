<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_cat_stat_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Food &amp; Dining"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorTextPrimary" />

        <TextView
            android:id="@+id/tv_cat_stat_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹8,500.00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorTextSecondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_cat_stat_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="32%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccentBrand" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_cat_stat"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="32"
        android:progressTint="?attr/colorAccentBrand"
        android:progressBackgroundTint="?attr/colorBorderStrong" />
</LinearLayout>
