<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorCardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_rounded_background">

        <!-- Top Row: Name, Asset Type, Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_asset_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nifty 50 Index Fund"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextPrimary" />

                <TextView
                    android:id="@+id/tv_asset_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mutual Funds"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/wealth_purple"
                    android:background="@drawable/badge_purple"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_edit_value"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_edit"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/btn_delete_investment"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_delete"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorBorder"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Metrics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invested"
                    android:textSize="11sp"
                    android:textColor="?attr/colorTextMuted" />

                <TextView
                    android:id="@+id/tv_invested_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹50,000.00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextPrimary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Value"
                    android:textSize="11sp"
                    android:textColor="?attr/colorTextMuted" />

                <TextView
                    android:id="@+id/tv_current_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹58,500.00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextPrimary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gain / Loss"
                    android:textSize="11sp"
                    android:textColor="?attr/colorTextMuted" />

                <TextView
                    android:id="@+id/tv_profit_loss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+₹8,500 (+17%)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/wealth_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
