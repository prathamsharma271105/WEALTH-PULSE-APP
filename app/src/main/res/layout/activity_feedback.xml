<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="?attr/colorCanvasBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header & Back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_back_feedback"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_transactions"
                android:rotation="180"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="12dp"
                app:tint="?attr/colorTextPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feedback &amp; Support"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We continuously improve WealthPulse based on your input"
                    android:textSize="12sp"
                    android:textColor="?attr/colorTextMuted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Feedback Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/card_rounded_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How can we help or improve?"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Describe feature requests, questions or issues you encountered"
                    android:textSize="12sp"
                    android:textColor="?attr/colorTextMuted"
                    android:layout_marginBottom="14dp" />

                <EditText
                    android:id="@+id/et_feedback_msg"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="@drawable/edit_text_bg"
                    android:gravity="top|start"
                    android:hint="Type your thoughts or issues here..."
                    android:textColorHint="?attr/colorTextDim"
                    android:textColor="?attr/colorTextPrimary"
                    android:padding="14dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_submit_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Submit Feedback Ticket"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_primary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
