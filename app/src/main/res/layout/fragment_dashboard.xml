<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorCanvasBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Executive Net Worth Hero Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/card_gradient_networth">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL NET WORTH"
                            android:textSize="12sp"
                            android:letterSpacing="0.08"
                            android:textStyle="bold"
                            android:textColor="#B0C4DE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Tracking"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/wealth_cyan"
                            android:background="@drawable/badge_blue" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_dash_net_worth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0.00"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#33FFFFFF"
                        android:layout_marginBottom="14dp" />

                    <!-- Sub totals row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Liquid Savings"
                                android:textSize="11sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:id="@+id/tv_dash_liquid_savings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0.00"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Investments"
                                android:textSize="11sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:id="@+id/tv_dash_investments_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0.00"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Cash Inflow & Outflow Stat Cards in 2 columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Inflow Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="?attr/colorCardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/card_gradient_inflow">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/wealth_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inflow"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorTextMuted"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_dash_income"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/wealth_green"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Outflow Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="?attr/colorCardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/card_gradient_outflow">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_trending_down"
                                app:tint="@color/wealth_red" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Outflow"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorTextMuted"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_dash_expense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/wealth_red"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- 3. Quick Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btn_dash_add_income"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="+ Income"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_success"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_dash_add_expense"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="- Expense"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_danger"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- 4. Monthly Dynamics Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorCardBackground"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/card_rounded_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cash Flow Dynamics"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monthly Inflow vs Outflow"
                                android:textSize="12sp"
                                android:textColor="?attr/colorTextMuted" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Real-Time"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/wealth_green"
                            android:background="@drawable/badge_green" />
                    </LinearLayout>

                    <com.example.financialtracker.views.BarChartView
                        android:id="@+id/chart_dash_bar"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. Category Distribution Donut Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorCardBackground"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/card_rounded_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expense Breakdown"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Where your cash goes"
                                android:textSize="12sp"
                                android:textColor="?attr/colorTextMuted" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Breakdown"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/wealth_amber"
                            android:background="@drawable/badge_amber" />
                    </LinearLayout>

                    <com.example.financialtracker.views.DonutChartView
                        android:id="@+id/chart_dash_donut"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. Habits & Discipline Preview -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorCardBackground"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/card_rounded_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Habits &amp; Streaks"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextPrimary" />

                        <TextView
                            android:id="@+id/tv_dash_habits_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/0 Completed Today"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/wealth_green"
                            android:background="@drawable/badge_green" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_dash_habits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_dash_no_habits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No financial habits created yet. Tap below to build one!"
                        android:textSize="13sp"
                        android:textColor="?attr/colorTextDim"
                        android:visibility="gone"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 7. Savings Goals Milestones Preview -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorCardBackground"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/card_rounded_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Savings Milestones"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextPrimary" />

                        <TextView
                            android:id="@+id/tv_dash_goals_total_saved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saved: ₹0.00"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorAccentBrand"
                            android:background="@drawable/badge_blue" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_dash_goals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_dash_no_goals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No savings goals yet. Start an emergency fund or travel goal!"
                        android:textSize="13sp"
                        android:textColor="?attr/colorTextDim"
                        android:visibility="gone"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
