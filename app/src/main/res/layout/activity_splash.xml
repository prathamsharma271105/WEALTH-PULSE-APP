<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="?attr/colorCanvasBackground"
    android:padding="32dp">

    <!-- Logo / Brand Icon -->
    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@mipmap/ic_launcher_round" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WealthPulse"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextPrimary"
        android:letterSpacing="0.02"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personal Finance &amp; Habit Intelligence"
        android:textSize="14sp"
        android:textColor="?attr/colorTextMuted"
        android:layout_marginTop="6dp" />

    <ProgressBar
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="?attr/colorAccentBrand"
        android:layout_marginTop="40dp" />
</LinearLayout>
