<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="?attr/colorCanvasBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join WealthPulse"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start tracking your cash flow and compounding wealth"
                android:textSize="13sp"
                android:textColor="?attr/colorTextMuted"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_rounded_background">

                <!-- Full Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name *"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextSecondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_reg_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_bg"
                    android:hint="John Doe"
                    android:textColorHint="?attr/colorTextDim"
                    android:textColor="?attr/colorTextPrimary"
                    android:inputType="textPersonName|textCapWords"
                    android:importantForAutofill="no"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address *"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextSecondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_reg_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_bg"
                    android:hint="you@example.com"
                    android:textColorHint="?attr/colorTextDim"
                    android:textColor="?attr/colorTextPrimary"
                    android:inputType="textEmailAddress"
                    android:importantForAutofill="no"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password (min 6 characters) *"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextSecondary"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp">

                    <EditText
                        android:id="@+id/et_reg_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/edit_text_bg"
                        android:hint="••••••••"
                        android:textColorHint="?attr/colorTextDim"
                        android:textColor="?attr/colorTextPrimary"
                        android:inputType="textPassword"
                        android:importantForAutofill="no"
                        android:paddingStart="14dp"
                        android:paddingEnd="46dp"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btn_toggle_reg_password"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:padding="11dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="Toggle Password Visibility" />
                </FrameLayout>

                <!-- Phone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextSecondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_reg_phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_bg"
                    android:hint="+91 98765 43210"
                    android:textColorHint="?attr/colorTextDim"
                    android:textColor="?attr/colorTextPrimary"
                    android:inputType="phone"
                    android:importantForAutofill="no"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <!-- Preferred Currency -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preferred Currency"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextSecondary"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/sp_reg_currency"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="24dp" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Create WealthPulse Account"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_primary" />

                <ProgressBar
                    android:id="@+id/pb_reg_loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="?attr/colorAccentBrand"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Go Login Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textSize="14sp"
                android:textColor="?attr/colorTextMuted" />

            <TextView
                android:id="@+id/tv_go_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAccentBrand" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
