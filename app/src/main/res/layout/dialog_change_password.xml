<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Password *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/et_curr_pass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/edit_text_bg"
            android:hint="••••••••"
            android:textColorHint="?attr/colorTextDim"
            android:textColor="?attr/colorTextPrimary"
            android:inputType="textPassword"
            android:importantForAutofill="no"
            android:paddingStart="12dp"
            android:paddingEnd="46dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_toggle_curr_pass"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_visibility_off"
            android:contentDescription="Toggle Current Password Visibility" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Password (min 6 chars) *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <EditText
            android:id="@+id/et_new_pass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/edit_text_bg"
            android:hint="••••••••"
            android:textColorHint="?attr/colorTextDim"
            android:textColor="?attr/colorTextPrimary"
            android:inputType="textPassword"
            android:importantForAutofill="no"
            android:paddingStart="12dp"
            android:paddingEnd="46dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_toggle_new_pass"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_visibility_off"
            android:contentDescription="Toggle New Password Visibility" />
    </FrameLayout>
</LinearLayout>
